# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Database.
#   Local dev (SQLite):   file:./dev.db
#   Production (Postgres): postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="file:./dev.db"

# Secret used to sign the admin session JWT. Generate a long random string:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed admin credentials (used by `npm run seed` to create the first admin).
ADMIN_EMAIL="admin@adriaticestates.com"
ADMIN_PASSWORD="changeme123"

# Vercel Blob token for property photo uploads.
#   Create a Blob store in the Vercel dashboard and copy the token here.
#   Leave blank for local dev if you are not testing uploads.
BLOB_READ_WRITE_TOKEN=""

# Canonical public URL, used by sitemap.xml and robots.txt in production.
#   e.g. https://adriaticestates.com  (leave unset for local dev)
NEXT_PUBLIC_SITE_URL=""
